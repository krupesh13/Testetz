{
  "appId": "com.portion.app",
  "appName": "Portion",
  "webDir": "www",
  "backgroundColor": "#34361f",
  "ios": {
    "contentInset": "never",
    "scrollEnabled": false,
    "backgroundColor": "#34361f"
  },
  "android": {
    "backgroundColor": "#34361f"
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css",
      "style": "DARK"
    },
    "SplashScreen": {
      "launchShowDuration": 600,
      "launchAutoHide": true,
      "launchFadeOutDuration": 300,
      "backgroundColor": "#5F6130",
      "showSpinner": false
    }
  }
}
